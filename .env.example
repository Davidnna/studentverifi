# Keep actual secrets in Vercel Settings > Environment Variables, never in source control.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=REPLACE_WITH_64_CHARACTER_RANDOM_SECRET
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
COOKIE_SECURE=true
FLASK_DEBUG=false
