# Configure these in Vercel -> Project Settings -> Environment Variables.
# Never commit values or a real .env file. Use the Neon POOLED URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=replace-with-at-least-32-random-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-10-to-128-character-password
COOKIE_SECURE=false
FLASK_DEBUG=false
# Optional for your institution's confirmed format; default is permissive.
# MATRIC_REGEX=^[A-Z0-9][A-Z0-9/._-]{3,49}$

# Nylas Transactional Send (Beta). The sending domain must be verified in Nylas.
NYLAS_API_KEY=
NYLAS_DOMAIN=your-verified-domain.nylas.email
NYLAS_FROM_EMAIL=no-reply@your-verified-domain.nylas.email
NYLAS_FROM_NAME=StudentVerifi
NYLAS_API_BASE_URL=https://api.us.nylas.com
# Optional: a monitored mailbox for replies.
NYLAS_REPLY_TO=

# Private student-photo storage: connect a PRIVATE Vercel Blob store to this project.
# Vercel supplies BLOB_READ_WRITE_TOKEN automatically after the store is connected.
BLOB_READ_WRITE_TOKEN=

# Public URL embedded in QR credentials and verifier invitation links.
APP_BASE_URL=https://your-studentverifi-domain.example
INSTITUTION_NAME=Ebonyi State University
