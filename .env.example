# Local development only. Never commit your real .env file.
# Use the Neon connection string from your Neon project.
# URL-encode special characters in the username/password if necessary.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-long-password
COOKIE_SECURE=false
FLASK_DEBUG=false
