# Configure these in Vercel -> Project Settings -> Environment Variables.
# Never commit values or a real .env file. Use the Neon POOLED URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-secret-at-least-10-characters
# Required only temporarily for one-time, browser-based database setup.
# Generate your own high-entropy value with at least 32 characters.
SETUP_TOKEN=replace-with-a-random-unguessable-secret-at-least-32-chars
COOKIE_SECURE=true
FLASK_DEBUG=false
# Optional for your institution's confirmed format; default is permissive.
# MATRIC_REGEX=^[A-Z0-9][A-Z0-9/._-]{3,49}$
