# Local development only. Never commit your real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-long-password
COOKIE_SECURE=false
FLASK_DEBUG=false
# Optional: paste Aiven's CA certificate PEM here for certificate verification.
# MYSQL_SSL_CA_PEM=-----BEGIN CERTIFICATE-----...
