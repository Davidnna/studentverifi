{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "flask",
    "buildCommand": "python build.py",
    "rewrites": [
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/login",
            "destination": "/index.html"
        },
        {
            "source": "/register",
            "destination": "/index.html"
        },
        {
            "source": "/dashboard",
            "destination": "/index.html"
        },
        {
            "source": "/students",
            "destination": "/index.html"
        },
        {
            "source": "/students/:segment",
            "destination": "/index.html"
        },
        {
            "source": "/students/demo-cleanup",
            "destination": "/index.html"
        },
        {
            "source": "/verify",
            "destination": "/index.html"
        },
        {
            "source": "/registration-requests",
            "destination": "/index.html"
        },
        {
            "source": "/logs",
            "destination": "/index.html"
        },
        {
            "source": "/admin-audit",
            "destination": "/index.html"
        },
        {
            "source": "/account/password",
            "destination": "/index.html"
        },
        {
            "source": "/student/account",
            "destination": "/index.html"
        },
        {
            "source": "/how-it-works",
            "destination": "/index.html"
        },
        {
            "source": "/about",
            "destination": "/index.html"
        },
        {
            "source": "/faq",
            "destination": "/index.html"
        },
        {
            "source": "/privacy",
            "destination": "/index.html"
        },
        {
            "source": "/contact",
            "destination": "/index.html"
        },
        {
            "source": "/verifiers",
            "destination": "/index.html"
        },
        {
            "source": "/verifier/dashboard",
            "destination": "/index.html"
        },
        {
            "source": "/verifier/activity",
            "destination": "/index.html"
        },
        {
            "source": "/verifier/accept",
            "destination": "/index.html"
        },
        {
            "source": "/credential/:token",
            "destination": "/index.html"
        },
        {
            "source": "/credential",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "app.py": {
            "excludeFiles": "{tests/**,frontend/src/**,node_modules/**}"
        }
    },
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob:"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "ignoreCommand": "if git log -1 --pretty=%s | grep -q '^build: publish React assets for Vercel'; then expected=$(git rev-parse HEAD^); if grep -q \"STUDENTVERIFI_SOURCE_COMMIT:${expected}\" public/index.html; then exit 1; fi; fi; exit 0"
}
